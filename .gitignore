# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local virtual environments and secrets
env/
.venv/
venv/
.env

# Generated research artefacts (recreate with main.py)
outputs/*
!outputs/.gitkeep
visualizations/*
!visualizations/.gitkeep

# Local data downloads and temporary run files
data/raw/
*.log

# Python tooling and local configuration
.python-version
.coverage
htmlcov/

# Jupyter runtime files
.ipynb_checkpoints/

# Keep raw source datasets under version control by default; ignore common exports
datasets/*.zip
datasets/*.xlsx

# Editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# React/Vite dependencies and build output
frontend/node_modules/
frontend/dist/
