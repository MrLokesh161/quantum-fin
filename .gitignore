# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local virtual environments and secrets
env/
.venv/
venv/
.env

# Generated research artefacts (recreate with run_pipeline.py)
outputs/*
!outputs/.gitkeep
visualizations/*
